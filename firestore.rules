rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // 0. Global Safety Net
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Phase 3: Primitive Definition
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && request.auth.uid == resource.data.uid;
    }

    function isClientLoanOwner() {
      return isSignedIn() && (
        ('clientUid' in resource.data && resource.data.clientUid == request.auth.uid) ||
        ('clientEmail' in resource.data && resource.data.clientEmail is string && request.auth.token.email is string && resource.data.clientEmail == request.auth.token.email.lower())
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPortalToken(token) {
      return token is string && token.size() >= 24 && token.size() <= 128 && token.matches('^cli_[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      // Relaxing email verification for development/preview to avoid blocking users
      return isSignedIn();
    }

    function isAdmin() {
      // Explicitly checking for the bootstrap admin email
      return isSignedIn() && request.auth.token.email == 'reyneperdigao@gmail.com';
    }

    // ==========================================
    // Phase 4: Validation Blueprints
    // ==========================================

    function isValidUser(data) {
      let requiredFields = ['role', 'uid'];
      return data.keys().hasAll(requiredFields) &&
             (data.email == null || (data.email is string && data.email.size() < 256)) &&
             data.role in ['admin', 'user', 'client'] &&
             data.uid == request.auth.uid &&
             (!('cpf' in data) || (data.cpf == null || (data.cpf is string && data.cpf.size() <= 20))) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('pixKey' in data) || (data.pixKey is string && data.pixKey.size() <= 200)) &&
             (!('pixName' in data) || (data.pixName is string && data.pixName.size() <= 100)) &&
             (!('pixBank' in data) || (data.pixBank is string && data.pixBank.size() <= 100)) &&
             (!('profilePicture' in data) || (data.profilePicture == null || (data.profilePicture is string && data.profilePicture.size() <= 2000000))) &&
             (!('lastClosureDate' in data) || (data.lastClosureDate == null || (data.lastClosureDate is string && data.lastClosureDate.size() <= 100)));
    }

    function isValidLoan(data) {
      let requiredFields = ['clientName', 'date', 'dueDate', 'capital', 'interestRate', 'totalBruto', 'status', 'uid'];
      return data.keys().hasAll(requiredFields) &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 120 &&
             data.date is string && data.date.size() <= 20 &&
             data.dueDate is string && data.dueDate.size() <= 20 &&
             data.capital is number && data.capital >= 0 &&
             data.interestRate is number && data.interestRate >= 0 &&
             data.totalBruto is number &&
             data.status in ['Pendente', 'Pago', 'Atrasado', 'Agendado'] &&
             data.uid == request.auth.uid &&
             (!('capitalPago' in data) || (data.capitalPago is number && data.capitalPago >= 0)) &&
             (!('jurosPagos' in data) || (data.jurosPagos is number && data.jurosPagos >= 0)) &&
             (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 50)) &&
             (!('clientAddress' in data) || (data.clientAddress is string && data.clientAddress.size() <= 300)) &&
             (!('clientCpf' in data) || (data.clientCpf is string && data.clientCpf.size() <= 20)) &&
             (!('clientEmail' in data) || (data.clientEmail == null || (data.clientEmail is string && data.clientEmail.size() <= 256))) &&
             (!('clientUid' in data) || (data.clientUid == null || (data.clientUid is string && data.clientUid.size() <= 128))) &&
             (!('clientProfession' in data) || (data.clientProfession is string && data.clientProfession.size() <= 100)) &&
             (!('clientMonthlyIncome' in data) || (data.clientMonthlyIncome is number && data.clientMonthlyIncome >= 0)) &&
             (!('clientReceivingDetails' in data) || (data.clientReceivingDetails is string && data.clientReceivingDetails.size() <= 500)) &&
             (!('registrationId' in data) || (data.registrationId is string && data.registrationId.size() <= 128)) &&
             (!('asaasChargeId' in data) || (data.asaasChargeId == null || (data.asaasChargeId is string && data.asaasChargeId.size() <= 128))) &&
             (!('asaasCustomerId' in data) || (data.asaasCustomerId == null || (data.asaasCustomerId is string && data.asaasCustomerId.size() <= 128))) &&
             (!('asaasBillingType' in data) || (data.asaasBillingType == null || (data.asaasBillingType is string && data.asaasBillingType.size() <= 30))) &&
             (!('asaasStatus' in data) || (data.asaasStatus == null || (data.asaasStatus is string && data.asaasStatus.size() <= 40))) &&
             (!('asaasInvoiceUrl' in data) || (data.asaasInvoiceUrl == null || (data.asaasInvoiceUrl is string && data.asaasInvoiceUrl.size() <= 500))) &&
             (!('asaasBankSlipUrl' in data) || (data.asaasBankSlipUrl == null || (data.asaasBankSlipUrl is string && data.asaasBankSlipUrl.size() <= 500))) &&
             (!('asaasPixPayload' in data) || (data.asaasPixPayload == null || (data.asaasPixPayload is string && data.asaasPixPayload.size() <= 1000))) &&
             (!('asaasPixQrCode' in data) || (data.asaasPixQrCode == null || (data.asaasPixQrCode is string && data.asaasPixQrCode.size() <= 200000))) &&
             (!('asaasBoletoLine' in data) || (data.asaasBoletoLine == null || (data.asaasBoletoLine is string && data.asaasBoletoLine.size() <= 200))) &&
             (!('asaasLastSyncAt' in data) || (data.asaasLastSyncAt == null || (data.asaasLastSyncAt is string && data.asaasLastSyncAt.size() <= 50))) &&
             (!('clientAccessToken' in data) || (data.clientAccessToken == null || isValidPortalToken(data.clientAccessToken))) &&
             (!('clientPortalEnabled' in data) || (data.clientPortalEnabled == null || data.clientPortalEnabled is bool));
    }

    function isCreatedAtImmutable() {
      return !('createdAt' in existing()) || incoming().createdAt == existing().createdAt;
    }

    function isActiveTimestamp() {
      return incoming().createdAt == request.time;
    }

    function isValidAction(data) {
      let requiredFields = ['type', 'description', 'clientName', 'loanId', 'date', 'uid'];
      return data.keys().hasAll(requiredFields) &&
             data.type in ['loan_created', 'payment_received', 'loan_deleted', 'loan_updated', 'loan_scheduled', 'loan_activated', 'loan_renewed'] &&
             data.description is string && data.description.size() <= 2000 &&
             data.clientName is string && data.clientName.size() <= 100 &&
             data.loanId is string && data.loanId.size() <= 128 &&
             data.date is string && data.date.size() <= 50 &&
             data.uid == request.auth.uid &&
             (!('clientEmail' in data) || (data.clientEmail == null || (data.clientEmail is string && data.clientEmail.size() <= 256))) &&
             (!('clientUid' in data) || (data.clientUid == null || (data.clientUid is string && data.clientUid.size() <= 128))) &&
             (!('amount' in data) || (data.amount == null || data.amount is number)) &&
             (!('capitalAmount' in data) || (data.capitalAmount == null || data.capitalAmount is number)) &&
             (!('interestAmount' in data) || (data.interestAmount == null || data.interestAmount is number)) &&
             (!('paymentMethod' in data) || (data.paymentMethod == null || data.paymentMethod in ['DINHEIRO', 'PIX'])) &&
             (!('operationType' in data) || (data.operationType == null || data.operationType in ['JUROS', 'AMORTIZACAO', 'QUITACAO', 'PAGAMENTO'])) &&
             (!('asaasChargeId' in data) || (data.asaasChargeId == null || (data.asaasChargeId is string && data.asaasChargeId.size() <= 128))) &&
             (!('confirmed' in data) || (data.confirmed == null || data.confirmed is bool));
    }

    function isValidClosure(data) {
      let requiredFields = ['userId', 'month', 'year', 'closedAt', 'closurePeriodEnd', 'stats'];
      return data.keys().hasAll(requiredFields) &&
             data.userId == request.auth.uid &&
             data.month is number && data.month >= 0 && data.month <= 11 &&
             data.year is number &&
             data.closedAt is string &&
             data.closurePeriodEnd is string &&
             data.stats is map;
    }

    function isValidSystemSettings(data) {
      let requiredFields = ['whatsappTemplate', 'defaultInterestRate', 'accentColor'];
      return data.keys().hasAll(requiredFields) &&
             data.whatsappTemplate is string && data.whatsappTemplate.size() <= 2000 &&
             (!('whatsappOverdueTemplate' in data) || (data.whatsappOverdueTemplate is string && data.whatsappOverdueTemplate.size() <= 2000)) &&
             data.defaultInterestRate is number &&
             data.accentColor in ['yellow', 'green', 'blue', 'violet', 'red'];
    }

    function isValidRegistrationLink(data) {
      let requiredFields = ['linkId', 'uid', 'lenderName', 'active', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(requiredFields) &&
             isValidId(data.linkId) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.lenderName is string && data.lenderName.size() > 0 && data.lenderName.size() <= 100 &&
             data.active is bool &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidClientRegistration(data) {
      let requiredFields = [
        'uid', 'linkId', 'fullName', 'cpf', 'phone', 'address', 'profession',
        'monthlyIncome', 'requestedAmount', 'receivingType', 'accountHolder',
        'receivingDetails', 'status', 'submittedAt'
      ];
      let allowedFields = [
        'uid', 'linkId', 'fullName', 'cpf', 'email', 'phone', 'address', 'profession',
        'monthlyIncome', 'requestedAmount', 'receivingType', 'pixKeyType',
        'pixKey', 'bankName', 'bankAgency', 'bankAccount', 'accountHolder',
        'receivingDetails', 'notes', 'status', 'submittedAt', 'approvedAt',
        'approvedAmount', 'loanId'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             isValidId(data.linkId) &&
             data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120 &&
             data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30 &&
             data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
             data.profession is string && data.profession.size() >= 2 && data.profession.size() <= 100 &&
             data.monthlyIncome is number && data.monthlyIncome > 0 &&
             data.requestedAmount is number && data.requestedAmount > 0 &&
             data.receivingType in ['PIX', 'CONTA_BANCARIA'] &&
             data.accountHolder is string && data.accountHolder.size() >= 2 && data.accountHolder.size() <= 120 &&
             data.receivingDetails is string && data.receivingDetails.size() >= 5 && data.receivingDetails.size() <= 500 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.submittedAt is string && data.submittedAt.size() <= 50 &&
             (!('pixKeyType' in data) || (data.pixKeyType is string && data.pixKeyType.size() <= 30)) &&
             (!('pixKey' in data) || (data.pixKey is string && data.pixKey.size() <= 200)) &&
             (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 100)) &&
             (!('bankAgency' in data) || (data.bankAgency is string && data.bankAgency.size() <= 30)) &&
             (!('bankAccount' in data) || (data.bankAccount is string && data.bankAccount.size() <= 40)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
             (!('approvedAmount' in data) || (data.approvedAmount is number && data.approvedAmount >= 0)) &&
             (!('loanId' in data) || (data.loanId is string && data.loanId.size() <= 128));
    }

    function isValidClientPortal(data) {
      let requiredFields = [
        'token', 'loanId', 'uid', 'lenderName', 'clientName', 'capital',
        'interestRate', 'periodInterest', 'totalBruto', 'date', 'dueDate',
        'status', 'capitalPago', 'jurosPagos', 'active', 'updatedAt'
      ];
      let allowedFields = [
        'token', 'loanId', 'uid', 'lenderName', 'clientName', 'capital',
        'interestRate', 'periodInterest', 'totalBruto', 'date', 'dueDate',
        'status', 'capitalPago', 'jurosPagos', 'asaasCustomerId', 'active', 'updatedAt'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             isValidPortalToken(data.token) &&
             isValidId(data.loanId) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.lenderName is string && data.lenderName.size() > 0 && data.lenderName.size() <= 100 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 120 &&
             data.capital is number && data.capital >= 0 &&
             data.interestRate is number && data.interestRate >= 0 &&
             data.periodInterest is number && data.periodInterest >= 0 &&
             data.totalBruto is number && data.totalBruto >= 0 &&
             data.date is string && data.date.size() <= 20 &&
             data.dueDate is string && data.dueDate.size() <= 20 &&
             data.status in ['Pendente', 'Pago', 'Atrasado', 'Agendado'] &&
             data.capitalPago is number && data.capitalPago >= 0 &&
             data.jurosPagos is number && data.jurosPagos >= 0 &&
             (!('asaasCustomerId' in data) || (data.asaasCustomerId == null || (data.asaasCustomerId is string && data.asaasCustomerId.size() <= 128))) &&
             data.active is bool &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidPortalCharge(data, portalToken) {
      let requiredFields = [
        'id', 'token', 'loanId', 'uid', 'operationType', 'totalAmount',
        'interestAmount', 'amortizedAmount', 'principalBefore', 'projectedNewCapital',
        'dueDateBefore', 'dueDateAfter', 'billingType', 'asaasChargeId',
        'asaasStatus', 'settled', 'createdAt', 'updatedAt'
      ];
      let allowedFields = [
        'id', 'token', 'loanId', 'uid', 'operationType', 'totalAmount',
        'interestAmount', 'amortizedAmount', 'principalBefore', 'projectedNewCapital',
        'dueDateBefore', 'dueDateAfter', 'billingType', 'asaasChargeId',
        'asaasStatus', 'asaasPixPayload', 'asaasPixQrCode', 'asaasInvoiceUrl',
        'asaasExpirationDate', 'settled', 'settledAt', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             isValidId(data.id) &&
             data.token == portalToken &&
             isValidPortalToken(data.token) &&
             isValidId(data.loanId) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.operationType in ['JUROS', 'AMORTIZACAO', 'QUITACAO'] &&
             data.totalAmount is number && data.totalAmount > 0 &&
             data.interestAmount is number && data.interestAmount >= 0 &&
             data.amortizedAmount is number && data.amortizedAmount >= 0 &&
             data.principalBefore is number && data.principalBefore >= 0 &&
             data.projectedNewCapital is number && data.projectedNewCapital >= 0 &&
             data.dueDateBefore is string && data.dueDateBefore.size() <= 20 &&
             data.dueDateAfter is string && data.dueDateAfter.size() <= 20 &&
             data.billingType == 'PIX' &&
             data.asaasChargeId is string && data.asaasChargeId.size() > 0 && data.asaasChargeId.size() <= 128 &&
             data.asaasStatus is string && data.asaasStatus.size() > 0 && data.asaasStatus.size() <= 40 &&
             (!('asaasPixPayload' in data) || (data.asaasPixPayload == null || (data.asaasPixPayload is string && data.asaasPixPayload.size() <= 1000))) &&
             (!('asaasPixQrCode' in data) || (data.asaasPixQrCode == null || (data.asaasPixQrCode is string && data.asaasPixQrCode.size() <= 200000))) &&
             (!('asaasInvoiceUrl' in data) || (data.asaasInvoiceUrl == null || (data.asaasInvoiceUrl is string && data.asaasInvoiceUrl.size() <= 500))) &&
             (!('asaasExpirationDate' in data) || (data.asaasExpirationDate == null || (data.asaasExpirationDate is string && data.asaasExpirationDate.size() <= 50))) &&
             data.settled is bool &&
             (!('settledAt' in data) || (data.settledAt == null || (data.settledAt is string && data.settledAt.size() <= 50))) &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidPortalPayment(data, portalToken) {
      let requiredFields = [
        'id', 'token', 'loanId', 'uid', 'operationType', 'amount',
        'interestAmount', 'amortizedAmount', 'paymentMethod', 'description', 'date'
      ];
      let allowedFields = [
        'id', 'token', 'loanId', 'uid', 'operationType', 'amount',
        'interestAmount', 'amortizedAmount', 'paymentMethod', 'description',
        'asaasChargeId', 'date'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             isValidId(data.id) &&
             data.token == portalToken &&
             isValidPortalToken(data.token) &&
             isValidId(data.loanId) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.operationType in ['JUROS', 'AMORTIZACAO', 'QUITACAO', 'PAGAMENTO'] &&
             data.amount is number && data.amount > 0 &&
             data.interestAmount is number && data.interestAmount >= 0 &&
             data.amortizedAmount is number && data.amortizedAmount >= 0 &&
             data.paymentMethod in ['PIX', 'DINHEIRO'] &&
             data.description is string && data.description.size() <= 500 &&
             (!('asaasChargeId' in data) || (data.asaasChargeId == null || (data.asaasChargeId is string && data.asaasChargeId.size() <= 128))) &&
             data.date is string && data.date.size() <= 50;
    }

    function isValidAsaasIntegration(data, userId) {
      let requiredFields = [
        'uid', 'configured', 'environment', 'apiKeyMasked',
        'hasWebhookToken', 'webhookUrl', 'updatedAt'
      ];
      let allowedFields = [
        'uid', 'configured', 'environment', 'apiKeyMasked',
        'hasWebhookToken', 'webhookTokenMasked', 'webhookUrl',
        'lastTestedAt', 'lastTestOk', 'updatedAt'
      ];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.configured is bool &&
             data.environment in ['sandbox', 'production'] &&
             data.apiKeyMasked is string && data.apiKeyMasked.size() <= 40 &&
             data.hasWebhookToken is bool &&
             (!('webhookTokenMasked' in data) || (data.webhookTokenMasked == null || (data.webhookTokenMasked is string && data.webhookTokenMasked.size() <= 40))) &&
             data.webhookUrl is string && data.webhookUrl.size() <= 300 &&
             (!('lastTestedAt' in data) || (data.lastTestedAt == null || (data.lastTestedAt is string && data.lastTestedAt.size() <= 50))) &&
             (!('lastTestOk' in data) || (data.lastTestOk == null || data.lastTestOk is bool)) &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // ==========================================
    // Collections
    // ==========================================

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) && isValidUser(incoming()) && isValidId(userId) &&
                    (incoming().role == 'client' || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && (isValidUser(incoming()) || isAdmin()) && isValidId(userId) &&
                    incoming().uid == existing().uid &&
                    (incoming().role == existing().role || isAdmin());

      match /settings/{settingId} {
        allow get, list: if isOwner(userId) && isValidId(settingId);
        allow create, update: if isOwner(userId) && isValidSystemSettings(incoming()) && isValidId(settingId);
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      match /integrations/{integrationId} {
        // Strictly owner-only: no cross-user or third-party access
        allow get, list: if isVerifiedUser() && isOwner(userId) && isValidId(userId);
        allow create, update: if isVerifiedUser() && isOwner(userId) && isValidId(userId) &&
                              isValidId(integrationId) && integrationId == 'asaas' &&
                              isValidAsaasIntegration(incoming(), userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) &&
                      isValidId(integrationId) && integrationId == 'asaas';
      }
    }

    match /loans/{loanId} {
      allow get: if isVerifiedUser() && (isDocOwner() || isAdmin() || isClientLoanOwner()) && isValidId(loanId);
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isClientLoanOwner());
      allow create: if isVerifiedUser() && isValidLoan(incoming()) && isActiveTimestamp() && isValidId(loanId);
      allow update: if isVerifiedUser() && isValidId(loanId) && (isAdmin() || (isDocOwner() && isValidLoan(incoming()) &&
                    incoming().uid == existing().uid &&
                    isCreatedAtImmutable() && (
                      // Action: Financial/Status (Amortization, Payment, Renewal, Payoff)
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'capital', 'totalBruto', 'capitalPago', 'jurosPagos', 'date', 'dueDate'])) ||
                      // Action: Asaas Charge Sync/Update
                      (incoming().diff(existing()).affectedKeys().hasOnly(['asaasChargeId', 'asaasCustomerId', 'asaasBillingType', 'asaasStatus', 'asaasInvoiceUrl', 'asaasBankSlipUrl', 'asaasPixPayload', 'asaasPixQrCode', 'asaasBoletoLine', 'asaasLastSyncAt'])) ||
                      // Action: Client Portal Token Provision/Toggle
                      (incoming().diff(existing()).affectedKeys().hasOnly(['clientAccessToken', 'clientPortalEnabled'])) ||
                      // Action: General Info Edit
                      (incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'clientPhone', 'clientAddress', 'clientCpf', 'clientEmail', 'clientUid', 'clientProfession', 'clientMonthlyIncome', 'clientReceivingDetails', 'clientAccessToken', 'clientPortalEnabled', 'date', 'dueDate', 'capital', 'interestRate', 'totalBruto', 'status', 'capitalPago', 'jurosPagos', 'asaasChargeId', 'asaasCustomerId', 'asaasBillingType', 'asaasStatus', 'asaasInvoiceUrl', 'asaasBankSlipUrl', 'asaasPixPayload', 'asaasPixQrCode', 'asaasBoletoLine', 'asaasLastSyncAt']))
                    )));
      allow delete: if isVerifiedUser() && isDocOwner() && isValidId(loanId);
    }

    match /actions/{actionId} {
      allow get: if isVerifiedUser() && (isDocOwner() || isClientLoanOwner()) && isValidId(actionId);
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isClientLoanOwner());
      allow create: if isVerifiedUser() && isValidAction(incoming()) && isValidId(actionId);
      allow update: if isVerifiedUser() && (isAdmin() || (isDocOwner() && isValidAction(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().loanId == existing().loanId));
      allow delete: if isVerifiedUser() && isDocOwner() && isValidId(actionId);
    }

    match /monthly_closures/{closureId} {
      allow get: if isVerifiedUser() && resource.data.userId == request.auth.uid && isValidId(closureId);
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidClosure(incoming()) && isValidId(closureId);
      allow update: if isVerifiedUser() && (isAdmin() || (resource.data.userId == request.auth.uid && isValidClosure(incoming())));
      allow delete: if isVerifiedUser() && resource.data.userId == request.auth.uid && isValidId(closureId);
    }

    match /registration_links/{linkId} {
      // Non-PII public lookup by exact linkId so clients can open the registration form
      allow get: if isValidId(linkId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidRegistrationLink(incoming()) && isValidId(linkId);
      allow update: if isVerifiedUser() && isValidId(linkId) && (isAdmin() || (isDocOwner() && isValidRegistrationLink(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().linkId == existing().linkId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['active', 'lenderName'])));
      allow delete: if isVerifiedUser() && isDocOwner() && isValidId(linkId);
    }

    match /client_registrations/{registrationId} {
      allow get: if isVerifiedUser() && (isDocOwner() || isAdmin()) && isValidId(registrationId);
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(registrationId) &&
                    isValidClientRegistration(incoming()) &&
                    incoming().status == 'pending' &&
                    exists(/databases/$(database)/documents/registration_links/$(incoming().linkId)) &&
                    get(/databases/$(database)/documents/registration_links/$(incoming().linkId)).data.active == true &&
                    get(/databases/$(database)/documents/registration_links/$(incoming().linkId)).data.uid == incoming().uid;
      allow update: if isVerifiedUser() && isValidId(registrationId) && (isAdmin() || (isDocOwner() && isValidClientRegistration(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().linkId == existing().linkId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedAmount', 'loanId'])));
      allow delete: if isVerifiedUser() && (isDocOwner() || isAdmin()) && isValidId(registrationId);
    }

    match /client_portals/{token} {
      // Non-PII isolated single-contract lookup using unguessable >= 24-char cryptographic token
      allow get: if isValidPortalToken(token);
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidPortalToken(token) && isValidClientPortal(incoming()) &&
                    incoming().token == token &&
                    exists(/databases/$(database)/documents/loans/$(incoming().loanId)) &&
                    get(/databases/$(database)/documents/loans/$(incoming().loanId)).data.uid == request.auth.uid;
      allow update: if isVerifiedUser() && isValidPortalToken(token) && (isAdmin() || (isDocOwner() && isValidClientPortal(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().token == existing().token &&
                    incoming().loanId == existing().loanId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['lenderName', 'clientName', 'capital', 'interestRate', 'periodInterest', 'totalBruto', 'date', 'dueDate', 'status', 'capitalPago', 'jurosPagos', 'asaasCustomerId', 'active', 'updatedAt'])));
      allow delete: if isVerifiedUser() && isDocOwner() && isValidPortalToken(token);

      match /charges/{chargeId} {
        allow get: if isValidPortalToken(token) && isValidId(chargeId);
        allow list: if isValidPortalToken(token) && (resource.data.token == token || (isVerifiedUser() && resource.data.uid == request.auth.uid));
        allow create: if isValidPortalToken(token) && isValidId(chargeId) && isValidPortalCharge(incoming(), token) &&
                      exists(/databases/$(database)/documents/client_portals/$(token)) &&
                      get(/databases/$(database)/documents/client_portals/$(token)).data.active == true &&
                      get(/databases/$(database)/documents/client_portals/$(token)).data.loanId == incoming().loanId &&
                      get(/databases/$(database)/documents/client_portals/$(token)).data.uid == incoming().uid && (
                        (isVerifiedUser() && incoming().uid == request.auth.uid) ||
                        (incoming().settled == false && incoming().asaasStatus in ['PENDING', 'AWAITING_RISK_ANALYSIS'])
                      );
        allow update: if isVerifiedUser() && isValidPortalToken(token) && isValidId(chargeId) &&
                      (isAdmin() || (isDocOwner() && isValidPortalCharge(incoming(), token) &&
                      incoming().uid == existing().uid &&
                      incoming().token == existing().token &&
                      incoming().loanId == existing().loanId &&
                      incoming().operationType == existing().operationType &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['asaasStatus', 'settled', 'settledAt', 'updatedAt'])));
        allow delete: if isVerifiedUser() && isDocOwner() && isValidPortalToken(token) && isValidId(chargeId);
      }

      match /payments/{paymentId} {
        allow get: if isValidPortalToken(token) && isValidId(paymentId);
        allow list: if isValidPortalToken(token) && (resource.data.token == token || (isVerifiedUser() && resource.data.uid == request.auth.uid));
        allow create: if isVerifiedUser() && isValidPortalToken(token) && isValidId(paymentId) &&
                      isValidPortalPayment(incoming(), token) &&
                      exists(/databases/$(database)/documents/client_portals/$(token)) &&
                      get(/databases/$(database)/documents/client_portals/$(token)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser() && isValidPortalToken(token) && isValidId(paymentId) && isAdmin();
        allow delete: if isVerifiedUser() && isDocOwner() && isValidPortalToken(token) && isValidId(paymentId);
      }
    }
  }
}

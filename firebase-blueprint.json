{
  "entities": {
    "loan": {
      "title": "Loan",
      "description": "Represents a loan given to a client.",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "description": "The name of the client."
        },
        "clientPhone": {
          "type": "string",
          "description": "The phone number of the client."
        },
        "clientAddress": {
          "type": "string",
          "description": "The address of the client."
        },
        "clientCpf": {
          "type": "string",
          "maxLength": 20,
          "description": "The CPF of the client."
        },
        "clientEmail": {
          "type": "string",
          "maxLength": 256,
          "description": "Lowercase email of the client for portal login and Asaas billing."
        },
        "clientUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional Firebase UID of the end client."
        },
        "clientProfession": {
          "type": "string",
          "maxLength": 100,
          "description": "The profession of the client."
        },
        "clientMonthlyIncome": {
          "type": "number",
          "description": "The declared monthly income of the client."
        },
        "clientReceivingDetails": {
          "type": "string",
          "maxLength": 500,
          "description": "PIX or bank account details for disbursing the loan."
        },
        "registrationId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional reference to the online registration document."
        },
        "asaasChargeId": { "type": "string", "maxLength": 128, "description": "Asaas payment ID." },
        "asaasCustomerId": { "type": "string", "maxLength": 128, "description": "Asaas customer ID." },
        "asaasBillingType": { "type": "string", "maxLength": 30, "description": "Asaas billing type." },
        "asaasStatus": { "type": "string", "maxLength": 40, "description": "Current Asaas payment status." },
        "asaasInvoiceUrl": { "type": "string", "maxLength": 500, "description": "Asaas checkout invoice URL." },
        "asaasBankSlipUrl": { "type": "string", "maxLength": 500, "description": "Asaas boleto PDF URL." },
        "asaasPixPayload": { "type": "string", "maxLength": 1000, "description": "Asaas Pix copy-paste EMV payload." },
        "asaasPixQrCode": { "type": "string", "maxLength": 200000, "description": "Asaas Pix QR code base64 image." },
        "asaasBoletoLine": { "type": "string", "maxLength": 200, "description": "Asaas boleto digitable line." },
        "asaasLastSyncAt": { "type": "string", "format": "date-time", "maxLength": 50, "description": "Last Asaas sync timestamp." },
        "clientAccessToken": { "type": "string", "minLength": 24, "maxLength": 128, "pattern": "^cli_[a-zA-Z0-9_\\-]+$", "description": "Exclusive cryptographic access token for the isolated contract client portal." },
        "clientPortalEnabled": { "type": "boolean", "description": "Whether the exclusive client portal link is active for this contract." },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date the loan was issued."
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "The date the loan is due."
        },
        "capital": {
          "type": "number",
          "description": "The principal amount borrowed."
        },
        "interestRate": {
          "type": "number",
          "description": "The monthly interest rate."
        },
        "totalBruto": {
          "type": "number",
          "description": "The total amount to be received (Capital + Interest)."
        },
        "capitalPago": {
          "type": "number",
          "description": "Total principal paid back."
        },
        "jurosPagos": {
          "type": "number",
          "description": "Total interest paid."
        },
        "status": {
          "type": "string",
          "enum": ["Pendente", "Pago", "Atrasado", "Agendado"],
          "description": "The current status of the loan."
        },
        "uid": {
          "type": "string",
          "description": "The UID of the user who created the loan."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the record was created."
        }
      },
      "required": ["clientName", "date", "dueDate", "capital", "interestRate", "totalBruto", "status", "uid"]
    },
    "user": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string", "description": "The custom name of the user for receipts." },
        "role": { "type": "string", "enum": ["admin", "user", "client"] },
        "uid": { "type": "string" },
        "cpf": { "type": "string", "maxLength": 20 },
        "pixKey": { "type": "string" },
        "pixName": { "type": "string" },
        "pixBank": { "type": "string" },
        "profilePicture": { "type": "string" },
        "lastClosureDate": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "uid"]
    },
    "system_action": {
      "title": "System Action",
      "description": "Represents an action performed in the system.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "capitalAmount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["DINHEIRO", "PIX"] },
        "operationType": { "type": "string", "enum": ["JUROS", "AMORTIZACAO", "QUITACAO", "PAGAMENTO"] },
        "asaasChargeId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string", "maxLength": 256 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "loanId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" },
        "confirmed": { "type": "boolean", "description": "Whether the transaction has been verified." }
      },
      "required": ["type", "description", "clientName", "loanId", "date", "uid"]
    },
    "monthly_closure": {
      "title": "Monthly Closure",
      "description": "Represents a monthly financial closure.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "closedAt": { "type": "string", "format": "date-time" },
        "closurePeriodEnd": { "type": "string", "format": "date-time" },
        "stats": {
          "type": "object",
          "properties": {
            "totalLent": { "type": "number" },
            "totalPayments": { "type": "number" },
            "capitalPayments": { "type": "number" },
            "interestPayments": { "type": "number" },
            "paymentCount": { "type": "number" },
            "loanCount": { "type": "number" },
            "currentOutstanding": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "month", "year", "closedAt", "closurePeriodEnd", "stats"]
    },
    "system_settings": {
      "title": "System Settings",
      "description": "User-specific system configuration.",
      "type": "object",
      "properties": {
        "whatsappTemplate": { "type": "string" },
        "whatsappOverdueTemplate": { "type": "string" },
        "defaultInterestRate": { "type": "number" },
        "accentColor": { "type": "string", "enum": ["yellow", "green", "blue", "violet", "red"] }
      },
      "required": ["whatsappTemplate", "defaultInterestRate", "accentColor"]
    },
    "registration_link": {
      "title": "Registration Link",
      "description": "Shareable public link metadata for online client credit registration.",
      "type": "object",
      "properties": {
        "linkId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "lenderName": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": ["linkId", "uid", "lenderName", "active", "createdAt"]
    },
    "client_registration": {
      "title": "Client Registration",
      "description": "Online credit registration request submitted by a prospective client.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "linkId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "cpf": { "type": "string", "minLength": 11, "maxLength": 20 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "address": { "type": "string", "minLength": 5, "maxLength": 300 },
        "profession": { "type": "string", "minLength": 2, "maxLength": 100 },
        "monthlyIncome": { "type": "number" },
        "requestedAmount": { "type": "number" },
        "receivingType": { "type": "string", "enum": ["PIX", "CONTA_BANCARIA"] },
        "pixKeyType": { "type": "string", "maxLength": 30 },
        "pixKey": { "type": "string", "maxLength": 200 },
        "bankName": { "type": "string", "maxLength": 100 },
        "bankAgency": { "type": "string", "maxLength": 30 },
        "bankAccount": { "type": "string", "maxLength": 40 },
        "accountHolder": { "type": "string", "minLength": 2, "maxLength": 120 },
        "receivingDetails": { "type": "string", "minLength": 5, "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "approvedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "approvedAmount": { "type": "number" },
        "loanId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "uid", "linkId", "fullName", "cpf", "phone", "address", "profession",
        "monthlyIncome", "requestedAmount", "receivingType", "accountHolder",
        "receivingDetails", "status", "submittedAt"
      ]
    },
    "client_portal": {
      "title": "Isolated Client Contract Portal",
      "description": "Token-isolated non-PII contract view for a single end-client contract link.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "minLength": 24, "maxLength": 128, "pattern": "^cli_[a-zA-Z0-9_\\-]+$" },
        "loanId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lenderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "capital": { "type": "number" },
        "interestRate": { "type": "number" },
        "periodInterest": { "type": "number" },
        "totalBruto": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Pendente", "Pago", "Atrasado", "Agendado"] },
        "capitalPago": { "type": "number" },
        "jurosPagos": { "type": "number" },
        "asaasCustomerId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": [
        "token", "loanId", "uid", "lenderName", "clientName", "capital",
        "interestRate", "periodInterest", "totalBruto", "date", "dueDate",
        "status", "capitalPago", "jurosPagos", "active", "updatedAt"
      ]
    },
    "client_portal_charge": {
      "title": "Client Portal PIX Charge",
      "description": "Tracks a generated Asaas PIX charge and its operation breakdown (JUROS, AMORTIZACAO, QUITACAO).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "token": { "type": "string", "minLength": 24, "maxLength": 128, "pattern": "^cli_[a-zA-Z0-9_\\-]+$" },
        "loanId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operationType": { "type": "string", "enum": ["JUROS", "AMORTIZACAO", "QUITACAO"] },
        "totalAmount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "amortizedAmount": { "type": "number" },
        "principalBefore": { "type": "number" },
        "projectedNewCapital": { "type": "number" },
        "dueDateBefore": { "type": "string", "maxLength": 20 },
        "dueDateAfter": { "type": "string", "maxLength": 20 },
        "billingType": { "type": "string", "enum": ["PIX"] },
        "asaasChargeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "asaasStatus": { "type": "string", "maxLength": 40 },
        "asaasPixPayload": { "type": "string", "maxLength": 1000 },
        "asaasPixQrCode": { "type": "string", "maxLength": 200000 },
        "asaasInvoiceUrl": { "type": "string", "maxLength": 500 },
        "asaasExpirationDate": { "type": "string", "maxLength": 50 },
        "settled": { "type": "boolean" },
        "settledAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": [
        "id", "token", "loanId", "uid", "operationType", "totalAmount",
        "interestAmount", "amortizedAmount", "principalBefore", "projectedNewCapital",
        "dueDateBefore", "dueDateAfter", "billingType", "asaasChargeId",
        "asaasStatus", "settled", "createdAt", "updatedAt"
      ]
    },
    "client_portal_payment": {
      "title": "Client Portal Payment History Item",
      "description": "Verified payment record visible inside an isolated contract portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "token": { "type": "string", "minLength": 24, "maxLength": 128, "pattern": "^cli_[a-zA-Z0-9_\\-]+$" },
        "loanId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operationType": { "type": "string", "enum": ["JUROS", "AMORTIZACAO", "QUITACAO", "PAGAMENTO"] },
        "amount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "amortizedAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["PIX", "DINHEIRO"] },
        "description": { "type": "string", "maxLength": 500 },
        "asaasChargeId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": [
        "id", "token", "loanId", "uid", "operationType", "amount",
        "interestAmount", "amortizedAmount", "paymentMethod", "description", "date"
      ]
    },
    "user_asaas_integration": {
      "title": "User Asaas Integration Metadata",
      "description": "Per-user non-secret Asaas integration state and masked metadata stored isolated per account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configured": { "type": "boolean" },
        "environment": { "type": "string", "enum": ["sandbox", "production"] },
        "apiKeyMasked": { "type": "string", "maxLength": 40 },
        "hasWebhookToken": { "type": "boolean" },
        "webhookTokenMasked": { "type": "string", "maxLength": 40 },
        "webhookUrl": { "type": "string", "maxLength": 300 },
        "lastTestedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "lastTestOk": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": [
        "uid", "configured", "environment", "apiKeyMasked",
        "hasWebhookToken", "webhookUrl", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/loans/{loanId}": {
      "schema": "loan",
      "description": "Collection of all loans."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile data."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "system_settings",
      "description": "User-specific settings (e.g. system)."
    },
    "/users/{userId}/integrations/{integrationId}": {
      "schema": "user_asaas_integration",
      "description": "Per-user isolated Asaas integration metadata (non-secret status, environment, masked suffix)."
    },
    "/actions/{actionId}": {
      "schema": "system_action",
      "description": "Log of all system actions."
    },
    "/monthly_closures/{closureId}": {
      "schema": "monthly_closure",
      "description": "History of monthly closures."
    },
    "/registration_links/{linkId}": {
      "schema": "registration_link",
      "description": "Shareable registration links created by lenders."
    },
    "/client_registrations/{registrationId}": {
      "schema": "client_registration",
      "description": "Client credit registration requests submitted online."
    },
    "/client_portals/{token}": {
      "schema": "client_portal",
      "description": "Token-isolated client portal documents mapped 1:1 to a single contract."
    },
    "/client_portals/{token}/charges/{chargeId}": {
      "schema": "client_portal_charge",
      "description": "PIX charges with operation breakdown generated for a contract portal."
    },
    "/client_portals/{token}/payments/{paymentId}": {
      "schema": "client_portal_payment",
      "description": "Payment history ledger for a single contract portal."
    }
  }
}


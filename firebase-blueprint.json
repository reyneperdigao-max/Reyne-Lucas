{
  "entities": {
    "loan": {
      "title": "Loan",
      "description": "Represents a loan given to a client.",
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "description": "The name of the client."
        },
        "clientPhone": {
          "type": "string",
          "description": "The phone number of the client."
        },
        "clientAddress": {
          "type": "string",
          "description": "The address of the client."
        },
        "clientCpf": {
          "type": "string",
          "maxLength": 20,
          "description": "The CPF of the client."
        },
        "clientProfession": {
          "type": "string",
          "maxLength": 100,
          "description": "The profession of the client."
        },
        "clientMonthlyIncome": {
          "type": "number",
          "description": "The declared monthly income of the client."
        },
        "clientReceivingDetails": {
          "type": "string",
          "maxLength": 500,
          "description": "PIX or bank account details for disbursing the loan."
        },
        "registrationId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional reference to the online registration document."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date the loan was issued."
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "The date the loan is due."
        },
        "capital": {
          "type": "number",
          "description": "The principal amount borrowed."
        },
        "interestRate": {
          "type": "number",
          "description": "The monthly interest rate."
        },
        "totalBruto": {
          "type": "number",
          "description": "The total amount to be received (Capital + Interest)."
        },
        "capitalPago": {
          "type": "number",
          "description": "Total principal paid back."
        },
        "jurosPagos": {
          "type": "number",
          "description": "Total interest paid."
        },
        "status": {
          "type": "string",
          "enum": ["Pendente", "Pago", "Atrasado", "Agendado"],
          "description": "The current status of the loan."
        },
        "uid": {
          "type": "string",
          "description": "The UID of the user who created the loan."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the record was created."
        }
      },
      "required": ["clientName", "date", "dueDate", "capital", "interestRate", "totalBruto", "status", "uid"]
    },
    "user": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string", "description": "The custom name of the user for receipts." },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "uid": { "type": "string" },
        "pixKey": { "type": "string" },
        "pixName": { "type": "string" },
        "pixBank": { "type": "string" },
        "profilePicture": { "type": "string" },
        "lastClosureDate": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "uid"]
    },
    "system_action": {
      "title": "System Action",
      "description": "Represents an action performed in the system.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "capitalAmount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["DINHEIRO", "PIX"] },
        "clientName": { "type": "string" },
        "loanId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" },
        "confirmed": { "type": "boolean", "description": "Whether the transaction has been verified." }
      },
      "required": ["type", "description", "clientName", "loanId", "date", "uid"]
    },
    "monthly_closure": {
      "title": "Monthly Closure",
      "description": "Represents a monthly financial closure.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "closedAt": { "type": "string", "format": "date-time" },
        "closurePeriodEnd": { "type": "string", "format": "date-time" },
        "stats": {
          "type": "object",
          "properties": {
            "totalLent": { "type": "number" },
            "totalPayments": { "type": "number" },
            "capitalPayments": { "type": "number" },
            "interestPayments": { "type": "number" },
            "paymentCount": { "type": "number" },
            "loanCount": { "type": "number" },
            "currentOutstanding": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "month", "year", "closedAt", "closurePeriodEnd", "stats"]
    },
    "system_settings": {
      "title": "System Settings",
      "description": "User-specific system configuration.",
      "type": "object",
      "properties": {
        "whatsappTemplate": { "type": "string" },
        "whatsappOverdueTemplate": { "type": "string" },
        "defaultInterestRate": { "type": "number" },
        "accentColor": { "type": "string", "enum": ["yellow", "green", "blue", "violet", "red"] }
      },
      "required": ["whatsappTemplate", "defaultInterestRate", "accentColor"]
    },
    "registration_link": {
      "title": "Registration Link",
      "description": "Shareable public link metadata for online client credit registration.",
      "type": "object",
      "properties": {
        "linkId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "lenderName": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 50 }
      },
      "required": ["linkId", "uid", "lenderName", "active", "createdAt"]
    },
    "client_registration": {
      "title": "Client Registration",
      "description": "Online credit registration request submitted by a prospective client.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "linkId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "cpf": { "type": "string", "minLength": 11, "maxLength": 20 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "address": { "type": "string", "minLength": 5, "maxLength": 300 },
        "profession": { "type": "string", "minLength": 2, "maxLength": 100 },
        "monthlyIncome": { "type": "number" },
        "requestedAmount": { "type": "number" },
        "receivingType": { "type": "string", "enum": ["PIX", "CONTA_BANCARIA"] },
        "pixKeyType": { "type": "string", "maxLength": 30 },
        "pixKey": { "type": "string", "maxLength": 200 },
        "bankName": { "type": "string", "maxLength": 100 },
        "bankAgency": { "type": "string", "maxLength": 30 },
        "bankAccount": { "type": "string", "maxLength": 40 },
        "accountHolder": { "type": "string", "minLength": 2, "maxLength": 120 },
        "receivingDetails": { "type": "string", "minLength": 5, "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "approvedAt": { "type": "string", "format": "date-time", "maxLength": 50 },
        "approvedAmount": { "type": "number" },
        "loanId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "uid", "linkId", "fullName", "cpf", "phone", "address", "profession",
        "monthlyIncome", "requestedAmount", "receivingType", "accountHolder",
        "receivingDetails", "status", "submittedAt"
      ]
    }
  },
  "firestore": {
    "/loans/{loanId}": {
      "schema": "loan",
      "description": "Collection of all loans."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile data."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "system_settings",
      "description": "User-specific settings (e.g. system)."
    },
    "/actions/{actionId}": {
      "schema": "system_action",
      "description": "Log of all system actions."
    },
    "/monthly_closures/{closureId}": {
      "schema": "monthly_closure",
      "description": "History of monthly closures."
    },
    "/registration_links/{linkId}": {
      "schema": "registration_link",
      "description": "Shareable registration links created by lenders."
    },
    "/client_registrations/{registrationId}": {
      "schema": "client_registration",
      "description": "Client credit registration requests submitted online."
    }
  }
}
